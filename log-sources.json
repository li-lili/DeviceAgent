{
  // 日志来源列表，修改后重启 Agent；业务文件直接进入压缩包，不解析文件内容。
  // 按天拉取要求文件名含 YYYY-MM-DD，例如 2026-10-16.log、app-2026-10-16.1.log。
  // 文件名日期按北京时间解释；最新文件模式无需日期，按修改时间选择。
  "log_sources": [
    {
      // 来源唯一标识，云端可用 today business 指定此来源。
      "source_id": "business",
      // 业务日志目录，相对于本文件所在目录，必须位于 allowed-root 内。
      "path": "business-logs/app",
      // 是否扫描子目录。
      "recursive": true,
      // 文件名匹配规则；可配置多个。
      "file_patterns": ["*.log"]
    },
    {
      // 摄像头 SDK 日志来源。
      "source_id": "camera_sdk",
      // SDK 日志目录。
      "path": "business-logs/sdk",
      // 是否扫描子目录。
      "recursive": true,
      // 仅采集 .log 文件。
      "file_patterns": ["*.log"]
    }
  ]
}
