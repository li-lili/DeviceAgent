# 首次克隆后复制为 device-agent.cloud.conf，再填写实际信息。
# device-agent.cloud.conf 已被 Git 忽略，请勿强制提交真实凭证。
# 设备码（即设备 SN），与云端绑定记录一致。
device=your-device-id
# 设备私钥 PEM（产线/PC 工具流程写入设备安全存储，Agent 只读不生成）。
# 无缓存 Token 时用其对 "noetix-enroll-v1|SN" 做 RSA-PSS 签名换取 Token。
# 公钥需先由 PC 管理工具调用 POST /v1/device-keys/bind 绑定到云端，Agent 不执行绑定。
private-key=/nv/priv.pem

host=emqx.test.humanuniverse.cn
port=1883
enroll-url=https://logserver.test.humanuniverse.cn/v1/enroll
model=devicesim
state-dir=run/cloud-agent
work-dir=run/cloud-work
sources-config=log-sources.json
log-file=run/agent.log
